              "getting-started/core-concepts"
            ]
          },
          {
            "group": "Maya",
            "icon": "sparkles",
            "pages": [
              "maya/index",
              "maya/chat-with-maya",
              "maya/interaction-requests",
              "maya/memory",
              "maya/outputs-and-deliverables"
            ]
          },
          {
            "group": "Agents & Swarms",
            "icon": "users",
            "pages": [
              "agents/index",
              "agents/create-an-agent",
              "agents/versions-and-publishing",
              "agents/messaging-channels",
              "swarms/index",
              "swarms/create-a-swarm",
              "swarms/swarm-chat-and-feed"
            ]
          },
          {
            "group": "Automation & Knowledge",
            "icon": "clock",
            "pages": [
              "jobs/index",
              "jobs/create-a-job",
              "knowledge/index",
              "knowledge/add-documents"
            ]
          },
          {
            "group": "Integrations",
            "icon": "plug",
            "pages": [
              "integrations/index",
              "integrations/connect-apps",
              "integrations/skills",
              "integrations/credentials",
              "integrations/browsers"
            ]
          }
        ]
      },
      {
        "tab": "Account & Marketplace",
        "groups": [
          {
            "group": "Marketplace",
            "icon": "store",
            "pages": [
              "marketplace/index",
              "marketplace/install-a-listing",
              "marketplace/sell-on-the-marketplace"
            ]
          },
          {
            "group": "Account & Billing",
            "icon": "credit-card",
            "pages": [
              "account/settings",
              "account/plans-and-billing",
              "account/usage-and-logs",
              "account/sharing"
            ]
          },
          {
            "group": "Help",
            "icon": "life-ring",
            "pages": [
              "help/faq",
              "help/troubleshooting"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/kolmena-logo-light.png",
    "dark": "/logo/kolmena-logo-dark.png",
