    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#030303"
    }
  },
  "fonts": {
    "family": "Instrument Sans"
  }
